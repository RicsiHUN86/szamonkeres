<Window x:Class="szamonkeres.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvtár nyilvántartó" Height="600" Width="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgBooks"
                  SelectionChanged="dgBooks_SelectionChanged"
                  AutoGenerateColumns="True"
                  Grid.Row="0"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <Label Content="Cím"/>
                <TextBox x:Name="txtTitle"/>

                <Label Content="Szerző"/>
                <TextBox x:Name="txtAuthor"/>

                <Label Content="Év"/>
                <TextBox x:Name="txtYear"/>

                <Label Content="Ár"/>
                <TextBox x:Name="txtPrice"/>

            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <Button Content="Új" Height="35" Margin="5"
                        Click="BtnNew_Click"/>


                <Button Content="Módosítás" Height="35" Margin="5"
                        Click="BtnUpdate_Click"/>

                <Button Content="Törlés" Height="35" Margin="5"
                        Click="BtnDelete_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>